func (s {{.Node.Name}}) {{.Field.Name|title}}() (shark.Struct, error) {
	{{template "_checktag" . -}}
	{{if .Default.IsValid -}}
	p, err := shark.Struct(s).Ptr({{.Field.Slot.Offset}})
	if err != nil {
		return shark.Ptr{}, err
	}
	return p.StructDefault({{.Default}})
	{{- else -}}
	p, err := shark.Struct(s).Ptr({{.Field.Slot.Offset}})
	return p.Struct(), err
	{{- end}}
}

