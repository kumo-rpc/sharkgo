func (s {{.Node.Name}}) {{.Field.Name|title}}() (shark.List, error) {
	{{template "_checktag" . -}}
	p, err := shark.Struct(s).Ptr({{.Field.Slot.Offset}})
	{{if .Default.IsValid -}}
	if err != nil {
		return shark.List{}, err
	}
	return  p.ListDefault({{.Default}})
	{{- else -}}
	return p.List(), err
	{{- end}}
}

{{template "_hasfield" .}}

func (s {{.Node.Name}}) Set{{.Field.Name|title}}(v shark.List) error {
	{{template "_settag" . -}}
	return shark.Struct(s).SetPtr({{.Field.Slot.Offset}}, v.ToPtr())
}
